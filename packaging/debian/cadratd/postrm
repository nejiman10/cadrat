#!/bin/sh
# cadratd: the removal steps dh_installsystemduser generates. Removal masks
# the unit and keeps the record of its links, so a reinstallation restores
# the state before removal; purge deletes the links and the record.
set -e

if [ "$1" = "remove" ]; then
    if [ -x /usr/bin/deb-systemd-helper ]; then
        deb-systemd-helper --user mask 'cadratd.service' >/dev/null || true
    fi
fi
if [ "$1" = "purge" ]; then
    if [ -x /usr/bin/deb-systemd-helper ]; then
        deb-systemd-helper --user purge 'cadratd.service' >/dev/null || true
        deb-systemd-helper --user unmask 'cadratd.service' >/dev/null || true
    fi
fi

#DEBHELPER#
exit 0
